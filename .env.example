# TFY AI Gateway (required)
TFY_GATEWAY_URL=https://your-org.truefoundry.cloud/api/llm/api/v1
TFY_API_KEY=tfy-...

# Linear project name (optional — if set, issues are created in this project)
LINEAR_PROJECT=

# TFY MCP Gateway for Linear (optional — skips issue creation if not set)
TFY_MCP_GATEWAY_URL=https://your-org.truefoundry.cloud/api/mcp/...
TFY_MCP_GATEWAY_KEY=tfy-...
